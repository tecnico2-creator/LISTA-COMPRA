rules_version = '2';

// Reglas básicas para uso personal (sin login).
// Cualquiera con la URL de tu proyecto de Firebase podría leer/escribir los datos,
// así que trátalas como un punto de partida y súbelas de nivel (con Firebase
// Authentication, por ejemplo) si vas a compartir la app con más gente.
service cloud.firestore {
  match /databases/{database}/documents {
    match /products/{productId} {
      allow read, write: if true;
    }
    match /shoppingList/{itemId} {
      allow read, write: if true;
    }
  }
}
